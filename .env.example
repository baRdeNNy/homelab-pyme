# homelab-pyme · Fase 5 — copia este archivo como .env y rellénalo.
# El .env está en .gitignore: NUNCA se sube al repositorio.

# --- FortiGate (usuario REST API "api-backup") ---
FGT_HOST=192.168.1.201
FGT_TOKEN=
# Clave con la que FortiOS cifra el backup (necesaria para restaurarlo)
FGT_BACKUP_PASSWORD=
# Backups que se conservan
FGT_RETENCION=14
# Certificado autofirmado: indica su CA en FGT_CA o pon false (solo en el lab)
FGT_VERIFY_TLS=false
FGT_CA=

# --- Proxmox VE (token automation@pve!informe, rol PVEAuditor) ---
PVE_HOST=192.168.1.200
PVE_PORT=8006
PVE_NODE=pve
PVE_TOKEN_ID=automation@pve!informe
PVE_TOKEN_SECRET=
PVE_VERIFY_TLS=false
PVE_CA=

# --- Salida (backups, informes y log). Por defecto: <repo>/salida ---
# SALIDA=C:\homelab-salida
